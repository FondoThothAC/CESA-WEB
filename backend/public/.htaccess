# ==============================================================================
# CESA WEB - Production Security & Performance Hardening
# Archivo: /backend/public/.htaccess
# ==============================================================================

# 1. SEGURIDAD: Prohibir listado de directorios
Options -Indexes

# 2. PROTECCIÓN: Denegar acceso a archivos sensibles
<FilesMatch "^\.env|manifest\.json|sw\.js">
    # Permitir manifest y sw para PWA
    Order allow,deny
    Allow from all
</FilesMatch>

# Proteger carpetas de configuración (relative to public)
<Directory "../config">
    Order deny,allow
    Deny from all
</Directory>

<Directory "../lib">
    Order deny,allow
    Deny from all
</Directory>

# 3. PERFORMANCE: Activar Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# 4. RUTAS: Manejo de PWA Start URL
# Asegurar que las rutas de PHP no revelen extensiones (opcional)
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [NC,L]

# 5. SEGURIDAD: Headers de Seguridad Básicos
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set X-XSS-Protection "1; mode=block"
