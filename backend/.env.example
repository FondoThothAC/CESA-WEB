# ==============================================================
# CESA WEB - Variables de entorno requeridas (backend/.env)
# Copiar a backend/.env y completar. SIN estos valores la API
# no arrancará o rechazará tokens (fail-closed desde v3.7).
# ==============================================================

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_NAME=cesa_web
DB_USER=cesa_admin
DB_PASS=

# --- Seguridad / JWT (OBLIGATORIA, min 32 caracteres) ---
# Generar con: openssl rand -base64 48
JWT_SECRET=
# Correos con privilegios de Master Admin, separados por comas
ADMIN_MASTER_EMAILS=software@fondothoth.com,a213203453@unison.mx

# --- Cifrado AES votaciones (Data Science) ---
APP_AES_KEY=

# --- Telegram webhook (OBLIGATORIAS para zeroclaw_webhook.php) ---
TELEGRAM_WEBHOOK_SECRET=
# chat_ids autorizados, separados por comas
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Proxies confiables (opcional) ---
# IPs de nginx/CDN autorizadas para enviar X-Forwarded-For
TRUSTED_PROXIES=

# --- IA (chatbot) ---
GROQ_API_KEY=
GEMINI_API_KEY=
# Cloudflare Tunnel / Ollama local (Motor Mac Mini)
CESA_MAC_MINI_URL=http://localhost:11434

# --- Tipo de cambio (Banxico SIE) ---
# Token gratuito de https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# --- Entorno y CORS ---
APP_ENV=production
# Dominio permitido para validación CORS
ALLOW_ORIGIN=https://cesa.unison.mx

# --- Notificaciones Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- SMTP / correo ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587

# --- Redes sociales (publicación automática) ---
META_PAGE_TOKEN=
META_APP_ID=
META_APP_SECRET=
